# Copie este arquivo para ".env" e ajuste os valores.
# Pegue os dois valores abaixo em: Supabase Dashboard → Project Settings → API.

# URL do projeto Supabase (ex: https://xxxxxxxxxxxx.supabase.co)
SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"

# service_role key — SECRETA, nunca exponha no frontend nem em repositórios
# públicos. Dá acesso total ao banco (ignora RLS) e ao Supabase Auth admin API.
SUPABASE_SERVICE_ROLE_KEY="troque-por-sua-service-role-key"

# Porta do servidor Express
PORT=3333

# URL do frontend (para CORS)
FRONTEND_URL="http://localhost:5173"
